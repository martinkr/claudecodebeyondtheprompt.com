---
// Organism: final call to action.
import type { ImageMetadata } from 'astro';
import Band from '../atoms/Band.astro';
import Backdrop from '../atoms/Backdrop.astro';
import Container from '../atoms/Container.astro';
import Stack from '../atoms/Stack.astro';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';
import Mark from '../atoms/Mark.astro';
import Link from '../atoms/Link.astro';
import CtaGroup from '../molecules/CtaGroup.astro';
import MetaList from '../molecules/MetaList.astro';

interface Props { wave: ImageMetadata; buy: { label: string; href: string }[]; release: string; publisher: { name: string; href: string }; meta: string[] }
const { wave, buy, release, publisher, meta } = Astro.props;
---
<Band tone="panel" label="cta-title" spacious>
  <Backdrop src={wave} fade="band" flip />
  <Container size="md">
    <Stack gap="lg" align="center">
      <Heading level={2} id="cta-title">Stop re-prompting. <Mark>Start engineering.</Mark></Heading>
      <Text tone="muted" size="lg">Out {release} from <Link href={publisher.href}>{publisher.name}</Link>. Pre-order now and get the book on release day.</Text>
      <CtaGroup links={buy} center />
      <MetaList items={meta} />
    </Stack>
  </Container>
</Band>
