---
interface Props { level?: 1 | 2 | 3 | 4 | 5 | 6; size?: 'display' | 'xl' | 'lg' | 'md' | 'sm' | 'xs'; id?: string }
const { level = 2, size, id } = Astro.props;
const Tag = `h${level}` as const;
const defaults = { 1: 'display', 2: 'xl', 3: 'lg', 4: 'md', 5: 'sm', 6: 'xs' } as const;
const sizes = {
  display: 'font-display text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.02]',
  xl: 'font-display text-3xl sm:text-5xl font-extrabold tracking-tight leading-[1.08]',
  lg: 'text-2xl font-bold leading-tight',
  md: 'text-xl font-semibold leading-snug',
  sm: 'text-lg font-semibold leading-snug',
  xs: 'text-base font-semibold text-muted',
};
---
<Tag id={id} class:list={['text-snow text-balance', sizes[size ?? defaults[level]]]}><slot /></Tag>
