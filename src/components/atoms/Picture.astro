---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; variant?: 'cover' | 'avatar'; eager?: boolean }
const { src, alt, variant = 'cover', eager = false } = Astro.props;
const variants = {
  cover: 'w-full max-w-[19rem] sm:max-w-sm lg:max-w-md h-auto drop-shadow-[0_40px_60px_rgba(2,9,23,0.75)]',
  avatar: 'size-28 rounded-full border-2 border-accent object-cover',
};
---
<Image src={src} alt={alt} class={variants[variant]} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined}
  widths={variant === 'avatar' ? [112, 220] : [304, 448, 896, 1135]} sizes={variant === 'avatar' ? '112px' : '(min-width: 1024px) 448px, (min-width: 640px) 384px, 304px'} />
