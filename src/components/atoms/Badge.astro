---
interface Props { tone?: 'accent' | 'muted' }
const { tone = 'muted' } = Astro.props;
---
<span class:list={['inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold',
  tone === 'accent' ? 'border-accent/50 bg-accent/10 text-accent' : 'border-line bg-panel text-muted']}><slot /></span>
